{
    "name": "tw-id-num",
    "version": "0.3.0",
    "description": "Check or generate Taiwan ID numbers. 檢查或是產生中華民國國民身分證統一編號(即身份證字號，而非營業人統一編號)，支援新式外來人口統一證號。也特別支援舊式外來人口統一證號的檢查。",
    "keywords": [
        "Taiwan",
        "中華民國",
        "台灣",
        "統一證號",
        "身份證字號"
    ],
    "homepage": "https://magiclen.org/tw-id-num/",
    "bugs": {
        "url": "https://github.com/magiclen/ts-tw-id-num/issues"
    },
    "license": "MIT",
    "author": "Magic Len",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/magiclen/ts-tw-id-num.git"
    },
    "files": [
        "lib",
        "dist"
    ],
    "type": "module",
    "types": "./lib/index.d.ts",
    "exports": "./lib/index.js",
    "scripts": {
        "test": "tsx --test",
        "clean": "rimraf lib dist",
        "typecheck": "tsc -p tsconfig.build.json --noEmit",
        "build": "npm run clean && rslib build",
        "build:watch": "rslib build --watch",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "knip": "knip",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm run knip",
        "prepare": "node setup-git-hooks.mjs",
        "prepack": "npm run build",
        "prepublishOnly": "npm run check && npm run test"
    },
    "devDependencies": {
        "@rslib/core": "^1.0.0",
        "@types/node": "^26.5.1",
        "knip": "^6.35.1",
        "oxfmt": "^0.68.0",
        "oxlint": "^1.83.0",
        "oxlint-tsgolint": "^7.0.2001",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=24"
    },
    "knip": {
        "ignore": [
            "dist/**"
        ]
    }
}
